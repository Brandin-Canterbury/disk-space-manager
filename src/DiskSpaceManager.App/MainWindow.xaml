<Window x:Class="DiskSpaceManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskSpaceManager.App"
        xmlns:core="clr-namespace:DiskSpaceManager.Core;assembly=DiskSpaceManager.Core"
        Title="Disk Space Manager" Width="1440" Height="920" MinWidth="980" MinHeight="600"
        Background="{StaticResource WindowBg}" Icon="app.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="Open" Click="Menu_Open" FontWeight="SemiBold" />
            <MenuItem Header="Show in File Explorer" Click="Menu_Reveal" />
            <MenuItem Header="Show in folder tree" Click="Menu_ShowInTree" />
            <MenuItem Header="Copy path" Click="Menu_CopyPath" />
            <Separator />
            <MenuItem Header="Rescan this folder" Click="Menu_Rescan" />
            <Separator />
            <MenuItem Header="Move to Recycle Bin" InputGestureText="Del" Click="Menu_Recycle" />
            <MenuItem Header="Delete permanently" InputGestureText="Shift+Del" Click="Menu_DeletePermanent" />
        </ContextMenu>

        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
            <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
        </Style>
        <Style x:Key="DupRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource RowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding GroupShade}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DupShade}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="NameCell">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" Margin="0,0,6,0" VerticalAlignment="Center"
                           Foreground="#F59E0B" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BarCell">
            <Grid>
                <ProgressBar Style="{StaticResource SizeBar}" Value="{Binding Percent, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SafetyCell">
            <Border Background="{Binding SafetyBrush}" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left">
                <TextBlock Text="{Binding SafetyText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Image Source="app.ico" Width="26" Height="26" Margin="0,0,10,0" />
                        <TextBlock Text="Disk Space Manager" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AdminButton" Content="Restart as administrator" Click="RestartAdmin_Click"
                                ToolTip="Administrator access lets the scan read protected folders (Windows, other users, system caches)." />
                        <Button x:Name="ScanFolderButton" Content="Scan a folder…" Click="ScanFolder_Click" />
                        <Button x:Name="ScanButton" Content="Scan selected drives" Style="{StaticResource Primary}" Click="Scan_Click" />
                        <Button x:Name="CancelButton" Content="Stop" Style="{StaticResource Danger}" Click="Cancel_Click" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Drive cards -->
            <ItemsControl x:Name="DriveCards" DockPanel.Dock="Top" Margin="12,10,12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:DriveCardVM}">
                        <Border Style="{StaticResource Card}" Width="300" Margin="4" Padding="12,10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MediaText}" Foreground="{StaticResource TextSoft}" FontSize="11" VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Selected}" VerticalContentAlignment="Center" ToolTip="Include in scan">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource SizeBar}" Height="10" Margin="0,8,0,6" Value="{Binding UsedPercent, Mode=OneWay}" Foreground="{Binding BarBrush}" />
                                <TextBlock Text="{Binding FreeText}" />
                                <TextBlock Text="{Binding TrendText}" Foreground="{StaticResource TextSoft}" FontSize="12"
                                           Visibility="{Binding HasTrend, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Margin="0,2,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Empty" FontSize="12" Click="EmptyRecycle_Click"
                                            Visibility="{Binding HasRecycle, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding RecycleText}" Foreground="{StaticResource TextSoft}" FontSize="12" />
                                </DockPanel>
                                <TextBlock Text="{Binding ScanInfo}" Foreground="{StaticResource TextSoft}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding HasScanInfo, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Scan progress -->
            <Border x:Name="ProgressPanel" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="16,8,16,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ProgressText" FontWeight="SemiBold" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6" Foreground="{StaticResource Accent}" BorderThickness="0" Background="#E5E7EB" />
                    <TextBlock x:Name="ProgressPath" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,5">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis" />
            </Border>

            <TabControl x:Name="Tabs" Margin="16,8,16,8">
                <!-- Explorer -->
                <TabItem Header="Explorer">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400" MinWidth="200" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <TreeView x:Name="Tree" BorderThickness="0" Padding="4"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          SelectedItemChanged="Tree_SelectedItemChanged" PreviewMouseRightButtonDown="Tree_PreviewRightDown"
                                          KeyDown="Tree_KeyDown">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Show in File Explorer" Click="Menu_Reveal" />
                                            <MenuItem Header="Copy path" Click="Menu_CopyPath" />
                                            <MenuItem Header="Rescan this folder" Click="Menu_Rescan" />
                                            <Separator />
                                            <MenuItem Header="Move to Recycle Bin" InputGestureText="Del" Click="Menu_Recycle" />
                                            <MenuItem Header="Delete permanently" InputGestureText="Shift+Del" Click="Menu_DeletePermanent" />
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            <Setter Property="Padding" Value="1,2" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type local:DirVM}" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                                                <ProgressBar Style="{StaticResource SizeBar}" Width="44" Value="{Binding Percent, Mode=OneWay}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding SizeText}" Width="66" TextAlignment="Right" Margin="0,0,8,0" Foreground="{StaticResource TextSoft}" />
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text=" ⚠" Foreground="#D97706" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                <TextBlock x:Name="TreeEmpty" Style="{StaticResource Hint}" Margin="20" HorizontalAlignment="Center" TextAlignment="Center"
                                           Text="Pick drives above and click 'Scan selected drives'.&#x0a;&#x0a;Tip: run as administrator to include protected system folders." />
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="280" MinHeight="80" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Left" x:Name="UpButton" Click="Up_Click" ToolTip="Up one level" Padding="8,4">
                                    <TextBlock Text="&#xE74A;" FontFamily="{StaticResource Icons}" />
                                </Button>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Open in Explorer" Click="OpenCurrent_Click" />
                                    <Button Content="Rescan" Click="RescanCurrent_Click" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="CurrentPathText" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CurrentInfoText" Foreground="{StaticResource TextSoft}" FontSize="12" />
                                </StackPanel>
                            </DockPanel>
                            <DataGrid x:Name="ContentsGrid" Grid.Row="1" RowStyle="{StaticResource RowStyle}" PreviewKeyDown="Grid_PreviewKeyDown">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="70" CellTemplate="{StaticResource BarCell}" SortMemberPath="Size" />
                                    <DataGridTemplateColumn Header="Name" Width="*" CellTemplate="{StaticResource NameCell}" SortMemberPath="Name" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="%" Binding="{Binding PercentText}" SortMemberPath="Size" Width="60" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="Files" Binding="{Binding FilesText}" SortMemberPath="Files" Width="80" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="Last modified" Binding="{Binding Modified, StringFormat=g}" Width="140" />
                                    <DataGridTextColumn Header="Untouched for" Binding="{Binding AgeText}" SortMemberPath="LastWriteTicks" Width="110" />
                                    <DataGridTextColumn Header="Last accessed" Binding="{Binding Accessed, StringFormat=g}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent" />
                            <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                <local:Treemap x:Name="Map" />
                            </Border>
                            <TextBlock Grid.Row="4" x:Name="MapHoverText" Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" Text="Treemap: each block's area is its size. Click a folder to drill in." />
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Largest files -->
                <TabItem Header="Largest files">
                    <DockPanel Margin="0,8,0,0">
                        <local:ListToolbar DockPanel.Dock="Top" Target="{Binding ElementName=FilesGrid}" x:Name="FilesToolbar">
                            <TextBlock Style="{StaticResource Hint}" Text="The biggest individual files across everything scanned." />
                        </local:ListToolbar>
                        <DataGrid x:Name="FilesGrid" RowStyle="{StaticResource RowStyle}" PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="70" CellTemplate="{StaticResource BarCell}" SortMemberPath="Size" />
                                <DataGridTemplateColumn Header="Name" Width="260" CellTemplate="{StaticResource NameCell}" SortMemberPath="Name" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*" ElementStyle="{StaticResource SoftCell}" />
                                <DataGridTextColumn Header="Last modified" Binding="{Binding Modified, StringFormat=d}" Width="100" />
                                <DataGridTextColumn Header="Untouched for" Binding="{Binding AgeText}" SortMemberPath="LastWriteTicks" Width="110" />
                                <DataGridTextColumn Header="Last opened" Binding="{Binding AccessAgeText}" SortMemberPath="LastAccessTicks" Width="100" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Largest folders -->
                <TabItem Header="Largest folders">
                    <DockPanel Margin="0,8,0,0">
                        <local:ListToolbar DockPanel.Dock="Top" Target="{Binding ElementName=FoldersGrid}">
                            <TextBlock Style="{StaticResource Hint}" Text="Every folder ranked by total size (parents include their subfolders)." />
                        </local:ListToolbar>
                        <DataGrid x:Name="FoldersGrid" RowStyle="{StaticResource RowStyle}" PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="70" CellTemplate="{StaticResource BarCell}" SortMemberPath="Size" />
                                <DataGridTextColumn Header="Folder" Binding="{Binding Path}" Width="*" ElementStyle="{StaticResource TrimCell}" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="Files" Binding="{Binding FilesText}" SortMemberPath="Files" Width="90" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="Last modified" Binding="{Binding Modified, StringFormat=d}" Width="100" />
                                <DataGridTextColumn Header="Untouched for" Binding="{Binding AgeText}" SortMemberPath="LastWriteTicks" Width="110" />
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="260" ElementStyle="{StaticResource SoftCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Untouched -->
                <TabItem Header="Untouched folders">
                    <DockPanel Margin="0,8,0,0">
                        <local:ListToolbar DockPanel.Dock="Top" Target="{Binding ElementName=StaleGrid}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Nothing modified in" VerticalAlignment="Center" />
                                <TextBox x:Name="StaleDaysBox" Width="50" Margin="6,0" />
                                <TextBlock Text="days, at least" VerticalAlignment="Center" />
                                <TextBox x:Name="StaleMinBox" Width="50" Margin="6,0" />
                                <TextBlock Text="GB" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="Apply" Click="StaleApply_Click" />
                            </StackPanel>
                        </local:ListToolbar>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6" FontSize="12"
                                   Text="'Untouched' means no file inside was created or modified in that time. Only the outermost folder is listed. 'Last opened' relies on NTFS last-access tracking, which Windows may update lazily." />
                        <DataGrid x:Name="StaleGrid" RowStyle="{StaticResource RowStyle}" PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="70" CellTemplate="{StaticResource BarCell}" SortMemberPath="Size" />
                                <DataGridTextColumn Header="Folder" Binding="{Binding Path}" Width="*" ElementStyle="{StaticResource TrimCell}" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="Files" Binding="{Binding FilesText}" SortMemberPath="Files" Width="80" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="Last modified" Binding="{Binding Modified, StringFormat=d}" Width="100" />
                                <DataGridTextColumn Header="Untouched for" Binding="{Binding AgeText}" SortMemberPath="LastWriteTicks" Width="110" />
                                <DataGridTextColumn Header="Last opened" Binding="{Binding AccessAgeText}" SortMemberPath="LastAccessTicks" Width="100" />
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="240" ElementStyle="{StaticResource SoftCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Archives -->
                <TabItem Header="Old archives &amp; installers">
                    <DockPanel Margin="0,8,0,0">
                        <local:ListToolbar DockPanel.Dock="Top" Target="{Binding ElementName=ArchivesGrid}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Older than" VerticalAlignment="Center" />
                                <TextBox x:Name="ArchiveDaysBox" Width="50" Margin="6,0" />
                                <TextBlock Text="days" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="ArchiveKindBox" Width="160" Margin="0,0,8,0" SelectedIndex="0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="All types" />
                                    <ComboBoxItem Content="Archive" />
                                    <ComboBoxItem Content="Disk image" />
                                    <ComboBoxItem Content="Installer" />
                                    <ComboBoxItem Content="Dump / backup / temp" />
                                </ComboBox>
                                <Button Content="Apply" Click="ArchiveApply_Click" />
                            </StackPanel>
                        </local:ListToolbar>
                        <DataGrid x:Name="ArchivesGrid" RowStyle="{StaticResource RowStyle}" PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Name" Width="280" CellTemplate="{StaticResource NameCell}" SortMemberPath="Name" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="140" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*" ElementStyle="{StaticResource SoftCell}" />
                                <DataGridTextColumn Header="Last modified" Binding="{Binding Modified, StringFormat=d}" Width="100" />
                                <DataGridTextColumn Header="Untouched for" Binding="{Binding AgeText}" SortMemberPath="LastWriteTicks" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Cleanup suggestions -->
                <TabItem Header="Cleanup suggestions">
                    <DockPanel Margin="0,8,0,0">
                        <local:ListToolbar DockPanel.Dock="Top" Target="{Binding ElementName=HogsGrid}">
                            <TextBlock x:Name="HogsSummary" Style="{StaticResource Hint}" />
                        </local:ListToolbar>
                        <DataGrid x:Name="HogsGrid" RowStyle="{StaticResource RowStyle}" PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Safety" Width="80" CellTemplate="{StaticResource SafetyCell}" SortMemberPath="Safety" />
                                <DataGridTextColumn Header="What" Binding="{Binding Kind}" Width="190" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="Folder" Binding="{Binding Path}" Width="*" ElementStyle="{StaticResource TrimCell}" />
                                <DataGridTextColumn Header="Untouched for" Binding="{Binding AgeText}" SortMemberPath="LastWriteTicks" Width="110" />
                                <DataGridTextColumn Header="Advice" Binding="{Binding Note}" Width="340" ElementStyle="{StaticResource SoftCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- File types -->
                <TabItem Header="File types">
                    <DockPanel Margin="0,8,0,0">
                        <local:ListToolbar DockPanel.Dock="Top" Target="{Binding ElementName=TypesGrid}">
                            <TextBlock Style="{StaticResource Hint}" Text="Space by file extension. Double-click a type to see its largest files." />
                        </local:ListToolbar>
                        <DataGrid x:Name="TypesGrid" MouseDoubleClick="TypesGrid_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="90" SortMemberPath="Size">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Style="{StaticResource SizeBar}" Value="{Binding Percent, Mode=OneWay}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="160" />
                                <DataGridTextColumn Header="Total size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="110" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="%" Binding="{Binding PercentText}" SortMemberPath="Size" Width="70" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="Files" Binding="{Binding CountText}" SortMemberPath="Count" Width="110" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="Average" Binding="{Binding AverageText}" Width="110" ElementStyle="{StaticResource RightCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Duplicates -->
                <TabItem Header="Duplicates">
                    <DockPanel Margin="0,8,0,0">
                        <local:ListToolbar DockPanel.Dock="Top" Target="{Binding ElementName=DupGrid}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Files ≥" VerticalAlignment="Center" />
                                <TextBox x:Name="DupMinBox" Width="50" Margin="6,0" />
                                <TextBlock Text="MB" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button x:Name="DupFindButton" Content="Find duplicates" Click="DupFind_Click" />
                                <Button x:Name="DupSelectButton" Content="Select extra copies" Click="DupSelect_Click"
                                        ToolTip="Selects every copy except the most recently modified one in each group" />
                                <TextBlock x:Name="DupStatus" Style="{StaticResource Hint}" Margin="4,0,0,0" />
                            </StackPanel>
                        </local:ListToolbar>
                        <DataGrid x:Name="DupGrid" RowStyle="{StaticResource DupRowStyle}" AlternatingRowBackground="{x:Null}" PreviewKeyDown="Grid_PreviewKeyDown"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="60" />
                                <DataGridTemplateColumn Header="Name" Width="260" CellTemplate="{StaticResource NameCell}" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*" ElementStyle="{StaticResource SoftCell}" />
                                <DataGridTextColumn Header="Last modified" Binding="{Binding Modified, StringFormat=g}" Width="140" />
                                <DataGridTextColumn Header="" Binding="{Binding Note}" Width="120" ElementStyle="{StaticResource SoftCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Settings -->
                <TabItem Header="Monitor &amp; settings" x:Name="SettingsTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Low-space monitor (system tray)" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                               Text="A tiny background app lives in the notification area, checks free space on a timer and pops a Windows notification when a drive drops below its limit. It also logs free space hourly so the drive cards can show how fast each drive is filling up." />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse x:Name="MonitorDot" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="MonitorStatus" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button x:Name="StartMonitorButton" Content="Start monitor" Click="StartMonitor_Click" />
                                        <Button Content="Send test notification" Click="TestToast_Click" />
                                        <CheckBox x:Name="AutoStartBox" Content="Start monitor when I sign in to Windows" VerticalAlignment="Center" Margin="8,0,0,0"
                                                  Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                                    </StackPanel>
                                    <TextBlock Text="Alert thresholds per drive" FontWeight="SemiBold" Margin="0,4,0,6" />
                                    <DataGrid x:Name="RulesGrid" IsReadOnly="False" SelectionMode="Single" Height="Auto" MaxHeight="260" CanUserSortColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Drive" Binding="{Binding Drive}" IsReadOnly="True" Width="70" />
                                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" IsReadOnly="True" Width="160" />
                                            <DataGridTextColumn Header="Currently free" Binding="{Binding FreeText}" IsReadOnly="True" Width="200" />
                                            <DataGridCheckBoxColumn Header="Alert" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                            <DataGridTextColumn Header="When free space below" Binding="{Binding Threshold}" Width="160" />
                                            <DataGridComboBoxColumn Header="Unit" x:Name="UnitColumn" SelectedItemBinding="{Binding Unit}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <TextBlock Text="Check every" VerticalAlignment="Center" />
                                            <TextBox x:Name="IntervalBox" Width="50" Margin="6,0" />
                                            <TextBlock Text="minutes" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <TextBlock Text="Remind again every" VerticalAlignment="Center" />
                                            <TextBox x:Name="RenotifyBox" Width="50" Margin="6,0" />
                                            <TextBlock Text="hours while low" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <TextBlock Text="Warn if a drive loses" VerticalAlignment="Center" />
                                            <TextBox x:Name="RapidDropBox" Width="50" Margin="6,0" />
                                            <TextBlock Text="GB within an hour (0 = off)" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="MonitorNetworkBox" Content="Monitor network drives" Margin="0,0,20,0" />
                                        <CheckBox x:Name="MonitorRemovableBox" Content="Monitor USB / removable drives" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Scanning" />
                                    <WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <TextBlock Text="Remember individual files ≥" VerticalAlignment="Center" />
                                            <TextBox x:Name="BigFileBox" Width="50" Margin="6,0" />
                                            <TextBlock Text="MB" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <TextBlock Text="Cleanup suggestions ≥" VerticalAlignment="Center" />
                                            <TextBox x:Name="HogMinBox" Width="50" Margin="6,0" />
                                            <TextBlock Text="MB" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <CheckBox x:Name="ScanNetworkBox" Content="Pre-select network drives for scanning" Margin="0,0,0,10" />
                                    <TextBlock Text="Skip these folders (one per line):" Margin="0,0,0,4" />
                                    <TextBox x:Name="ExcludedBox" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Save settings" Style="{StaticResource Primary}" Click="SaveSettings_Click" />
                                <TextBlock x:Name="SettingsSaved" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Busy overlay -->
        <Grid x:Name="BusyOverlay" Background="#80FFFFFF" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,16">
                <StackPanel>
                    <TextBlock x:Name="BusyText" FontWeight="SemiBold" Text="Working…" />
                    <ProgressBar IsIndeterminate="True" Height="4" Width="260" Margin="0,10,0,0" Foreground="{StaticResource Accent}" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
