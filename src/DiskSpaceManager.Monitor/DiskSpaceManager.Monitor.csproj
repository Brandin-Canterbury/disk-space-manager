<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DiskSpaceMonitor</AssemblyName>
    <RootNamespace>DiskSpaceManager.Monitor</RootNamespace>
    <ApplicationIcon>..\DiskSpaceManager.App\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Keep the always-on tray process small. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiskSpaceManager.Core\DiskSpaceManager.Core.csproj" />
  </ItemGroup>
</Project>
